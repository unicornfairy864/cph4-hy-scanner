page { background: #f2f5f1; color: #142923; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.editor { padding: 24rpx 24rpx 38rpx; padding-bottom: calc(38rpx + env(safe-area-inset-bottom)); }
.panel { background: #fff; border: 1rpx solid #dfe7e1; border-radius: 28rpx; margin-bottom: 18rpx; padding: 24rpx; }
button { border: none; border-radius: 16rpx; box-sizing: border-box; font-size: 27rpx; font-weight: 600; line-height: 1.3; margin: 0; min-height: 72rpx; padding: 18rpx 14rpx; }
button::after { border: none; }
button[disabled] { opacity: 0.55; }
.secondary { background: #eef4ef; color: #204137; }
.primary { background: #185e53; color: #fff; }
.full { margin-top: 16rpx; width: 100%; }
.tabs { display: flex; gap: 12rpx; }
.tabs > button { background: #eef4ef; color: #204137; flex: 1; }
button.selected { background: #deefe7; box-shadow: inset 0 0 0 2rpx #257569; color: #104b40; }
.stage-wrap { align-items: center; background: #152b25; border-radius: 20rpx; display: flex; justify-content: center; margin-top: 18rpx; min-height: 180rpx; overflow: hidden; }
.decorate-stage { position: relative; }
.stage-image { display: block; height: 100%; pointer-events: none; width: 100%; }
.mask { border: 2rpx solid #65efc9; box-sizing: border-box; position: absolute; }
.mask-active { border-color: #fff; outline: 2rpx solid #185e53; }
.mask-resize { bottom: -12rpx; height: 36rpx; position: absolute; right: -12rpx; width: 36rpx; }
.mask-resize::after { background: #fff; border: 3rpx solid #185e53; border-radius: 50%; content: ''; height: 14rpx; left: 9rpx; position: absolute; top: 9rpx; width: 14rpx; }
.mask-draft { background: #19453e66; border: 2rpx dashed #fff; pointer-events: none; }
.watermark-pin { background: #185e53; border: 2rpx solid #fff; border-radius: 50%; height: 14rpx; pointer-events: none; position: absolute; transform: translate(-50%,-50%); width: 14rpx; }
.message { color: #586963; font-size: 25rpx; line-height: 1.45; margin-top: 12rpx; }
.label { font-size: 28rpx; font-weight: 600; margin: 16rpx 0 4rpx; }
.mosaic-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.mosaic-list button { min-height: 56rpx; padding: 14rpx; }
.watermark-input { background: #eef4ef; border-radius: 14rpx; font-size: 28rpx; min-height: 62rpx; margin-top: 16rpx; padding: 8rpx 16rpx; }
.swatches { display: flex; gap: 18rpx; margin: 18rpx 0 8rpx; }
button.swatch { border: 1rpx solid #c9d9d0; border-radius: 50%; height: 52rpx; min-height: 52rpx; padding: 0; width: 52rpx; }
button.swatch-selected { outline: 4rpx solid #257569; outline-offset: 4rpx; }
.layout-tabs { margin-top: 16rpx; }
.switch-row { align-items: center; display: flex; font-size: 28rpx; justify-content: space-between; }
.editor-actions { display: flex; gap: 16rpx; }
.editor-actions > button { flex: 1; }
