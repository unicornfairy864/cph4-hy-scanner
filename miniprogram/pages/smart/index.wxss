page {
  background: #f2f5f1;
  color: #142923;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

.smart-page { padding: 24rpx 24rpx 44rpx; padding-bottom: calc(44rpx + env(safe-area-inset-bottom)); }
.panel { background: #fff; border: 1rpx solid #dfe7e1; border-radius: 26rpx; margin-bottom: 20rpx; padding: 26rpx; }
.heading { color: #1a3128; font-size: 32rpx; font-weight: 650; }
.cloud-heading { align-items: center; display: flex; gap: 8rpx; }
.cloud-icon { flex: none; height: 34rpx; width: 34rpx; }
.button-row, .compare-row { display: flex; gap: 12rpx; }
.button-row { margin-top: 18rpx; }
.preview-bar, .question-bar, .progress { align-items: center; display: flex; gap: 10rpx; justify-content: space-between; }
.preview { align-items: center; background: #152b25; border-radius: 18rpx; color: #e7eee9; display: flex; font-size: 26rpx; height: 36vh; justify-content: center; margin-top: 14rpx; overflow: hidden; padding: 0 12rpx; }
.preview image { height: 100%; width: 100%; }

button { border: none; border-radius: 15rpx; box-sizing: border-box; font-size: 27rpx; font-weight: 600; line-height: 1.3; margin: 0; min-height: 74rpx; padding: 18rpx 16rpx; }
button::after { border: none; }
button[disabled] { opacity: 0.6; }
button.primary { background: #185e53; color: #fff; }
button.secondary, button.tool, button.compare { background: #edf4ef; color: #204137; }
button.active { background: #deefe7; box-shadow: inset 0 0 0 2rpx #257569; color: #104b40; }
.button-row button { flex: 1; }
.compare-row { gap: 6rpx; }
button.compare, button.compact { font-size: 24rpx; min-height: 50rpx; padding: 10rpx 14rpx; white-space: nowrap; }
.tool-grid { display: grid; gap: 12rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 20rpx 0; }
.process-button { margin-top: 22rpx; width: 100%; }
.progress { background: #e5f0e9; border-radius: 14rpx; font-size: 27rpx; margin-top: 18rpx; padding: 14rpx 16rpx; }

.note, .empty, .notice, .question-detail { color: #56675d; font-size: 26rpx; line-height: 1.5; }
.notice { background: #faf0dc; border-radius: 15rpx; color: #684823; margin-top: 14rpx; overflow-wrap: anywhere; padding: 16rpx 18rpx; }
.empty { padding-top: 26rpx; }
.fields { margin-top: 18rpx; }
.field { align-items: baseline; border-bottom: 1rpx solid #e3ebe5; display: flex; font-size: 27rpx; gap: 12rpx; line-height: 1.45; padding: 13rpx 0; }
.field-label { color: #52655a; flex: 0 0 160rpx; overflow-wrap: anywhere; }
.field-value { flex: 1; min-width: 0; overflow-wrap: anywhere; white-space: pre-wrap; }
.warning { color: #85612c; flex: none; font-size: 23rpx; }
.question { border-top: 1rpx solid #e3ebe5; margin-top: 18rpx; padding-top: 18rpx; }
.question-title { font-size: 28rpx; font-weight: 650; }
.question-text { display: block; font-size: 28rpx; line-height: 1.5; margin: 8rpx 0; overflow-wrap: anywhere; white-space: pre-wrap; }
.question-detail { margin-top: 3rpx; overflow-wrap: anywhere; white-space: pre-wrap; }
.grade { background: #eef4ef; border-radius: 16rpx; color: #38594a; font-size: 23rpx; padding: 4rpx 11rpx; white-space: nowrap; }
.grade.incorrect { background: #f6e8e0; color: #8b442a; }
.grade.uncertain { background: #faf0dc; color: #684823; }
