page {
  background: #f2f5f1;
  color: #142923;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

.scanner { padding: 24rpx 24rpx 144rpx; }

.panel {
  background: #fff;
  border: 1rpx solid #dfe7e1;
  border-radius: 30rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.heading { font-size: 34rpx; font-weight: 650; line-height: 1.35; }
.support { color: #586963; font-size: 26rpx; line-height: 1.5; }
.panel-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.button-row { display: flex; gap: 14rpx; }
.button-row > button { flex: 1; }

button {
  border: none;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.25;
  margin: 0;
  min-height: 76rpx;
  padding: 20rpx 12rpx;
}

button::after { border: none; }
button.primary { background: #185e53; color: #fff; }
button.secondary, button.option { background: #eef4ef; color: #204137; }
button.option-active { background: #deefe7; color: #104b40; box-shadow: inset 0 0 0 2rpx #257569; }
button.danger { color: #a7382e; }
button[disabled] { background: #f4f5f3; color: #71827a; opacity: 0.7; }
button.text-button { color: #185e53; background: transparent; min-height: 58rpx; padding: 10rpx 0 10rpx 16rpx; }

.welcome {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 60vh;
  text-align: center;
}

.welcome-title { color: #142923; font-size: 54rpx; font-weight: 720; letter-spacing: 2rpx; margin: 34rpx 0 8rpx; }
.welcome-actions { margin-top: 48rpx; width: 100%; }
.welcome-actions > button { min-height: 88rpx; }

.paper-mark {
  align-items: center;
  background: #e8f2ec;
  border-radius: 36rpx;
  display: flex;
  height: 128rpx;
  justify-content: center;
  width: 128rpx;
}

.mark-page {
  background: #fff;
  border: 4rpx solid #267466;
  border-radius: 10rpx;
  box-shadow: 8rpx 8rpx 0 #b6d6c7;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  height: 72rpx;
  justify-content: center;
  padding-inline: 11rpx;
  width: 54rpx;
}

.mark-page > view { background: #4a8b7d; border-radius: 4rpx; height: 4rpx; }
.mark-page > view:last-child { width: 65%; }

.image-frame {
  background: #152b25;
  border-radius: 20rpx;
  height: 53vh;
  margin: 16rpx 0 18rpx;
  max-height: 980rpx;
  min-height: 400rpx;
  overflow: hidden;
}

.page-image { display: block; height: 100%; width: 100%; }
.candidate-frame { height: 38vh; min-height: 300rpx; }
.enhanced-label { margin-bottom: 18rpx; }

.thumbnail-strip { margin-top: 18rpx; white-space: nowrap; width: 100%; }
.thumbnail {
  background: #eef4ef;
  border: 3rpx solid transparent;
  border-radius: 14rpx;
  box-sizing: border-box;
  display: inline-block;
  height: 152rpx;
  margin-right: 12rpx;
  padding: 8rpx;
  text-align: center;
  vertical-align: top;
  width: 112rpx;
}

.thumbnail-selected { border-color: #185e53; }
.thumbnail > image { height: 102rpx; width: 90rpx; }
.thumbnail-number { color: #29463e; font-size: 22rpx; line-height: 24rpx; }
.collection-actions { margin-top: 16rpx; }
.options { margin: 18rpx 0; }
.setting { display: flex; align-items: center; justify-content: space-between; font-size: 28rpx; min-height: 78rpx; }
.setting switch { transform: scale(0.8); transform-origin: right center; }
.full-width { margin-top: 14rpx; width: 100%; }
.cloud-options { border-top: 1rpx solid #e1e9e4; margin-top: 18rpx; padding-top: 18rpx; }
.cloud-options .button-row { margin-top: 12rpx; }

.field { color: #29463e; font-size: 28rpx; margin-top: 22rpx; }
.field input {
  background: #f2f6f3;
  border: 1rpx solid #dfe7e1;
  border-radius: 16rpx;
  color: #142923;
  height: 74rpx;
  margin-top: 10rpx;
  padding: 0 20rpx;
}

.quality-options { margin: 12rpx 0 20rpx; }
.export-button { width: 100%; }
.export-note { margin-top: 16rpx; }

.crop-panel .support { margin-top: 8rpx; }
.crop-stage {
  align-items: center;
  background: #152b25;
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  margin: 26rpx -16rpx 24rpx;
  min-height: 360rpx;
  padding: 38rpx 0;
}

.crop-image { position: relative; }
.crop-photo { display: block; height: 100%; width: 100%; }
.crop-edge {
  background: #57debc;
  box-shadow: 0 1rpx 4rpx #103831;
  height: 4rpx;
  pointer-events: none;
  position: absolute;
  transform-origin: left center;
}

.crop-handle {
  align-items: center;
  display: flex;
  height: 76rpx;
  justify-content: center;
  position: absolute;
  transform: translate(-50%, -50%);
  width: 76rpx;
  z-index: 1;
}

.handle-circle {
  background: #185e53;
  border: 5rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 3rpx 8rpx #0007;
  height: 26rpx;
  width: 26rpx;
}

.status {
  align-items: center;
  background: #173e35;
  border-radius: 24rpx;
  bottom: 30rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-shadow: 0 12rpx 30rpx #18392a33;
  color: #fff;
  display: flex;
  font-size: 26rpx;
  justify-content: space-between;
  left: 24rpx;
  min-height: 48rpx;
  padding: 18rpx 24rpx;
  position: fixed;
  right: 24rpx;
  z-index: 2;
}

.status-message { align-items: center; display: flex; gap: 16rpx; }
.status-dot { background: #8de1ba; border-radius: 50%; height: 13rpx; width: 13rpx; }
button.status-cancel { background: #2b5b4f; color: #fff; min-height: 58rpx; padding: 12rpx 24rpx; }
