<view class="scanner">
  <scroll-view wx:if="{{cropOpen}}" class="crop-host" scroll-y>
    <crop-editor source="{{source}}" corners="{{corners}}" rotation="{{cropRotation}}" width="{{cropWidth}}" height="{{cropHeight}}"
      auto-detected="{{autoDetected}}" partial-detected="{{partialDetected}}" corner-confidences="{{cornerConfidences}}"
      bindcancel="closeCrop" bindapply="applyCrop" />
  </scroll-view>

  <view wx:if="{{!pageCount}}" class="welcome panel">
    <view class="paper-mark" aria-hidden="true"><view class="mark-page"><view /><view /><view /></view></view>
    <view class="welcome-title">扫描文档</view>
    <view class="support">拍照或导入图片，校正页面并合成 PDF。</view>
    <view class="button-row welcome-actions">
      <button class="primary" bindtap="takePhoto" disabled="{{!!busy}}">拍照扫描</button>
      <button class="secondary" bindtap="showImportOptions" disabled="{{!!busy}}">导入图片</button>
    </view>
    <view class="button-row welcome-tools">
      <button class="secondary" bindtap="openArchive" disabled="{{!!busy}}">错题归档</button>
      <button class="secondary" bindtap="openPdfSigning" disabled="{{!!busy}}">签署已有 PDF</button>
    </view>
  </view>

  <view class="workspace {{cropOpen || !pageCount ? 'workspace-hidden' : ''}}">
    <view class="fixed-preview">
      <view class="preview-toolbar">
        <view class="preview-count">{{selected + 1}} / {{pageCount}}</view>
        <view class="segment" aria-label="图像预览">
          <button class="{{showOriginal ? 'segment-active' : ''}}" data-view="original" bindtap="selectPreview" disabled="{{!!busy || hasMosaic}}">原图</button>
          <button class="{{!showOriginal ? 'segment-active' : ''}}" data-view="effect" bindtap="selectPreview" disabled="{{!!busy}}">效果</button>
        </view>
        <view class="preview-actions">
          <text class="save-label">保存为：</text>
          <button class="save-button" bindtap="saveJpg" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}" aria-label="保存图片为 JPG">图片</button>
          <button class="save-button" bindtap="openExport" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}" aria-label="导出 PDF">PDF</button>
        </view>
      </view>

      <view class="image-frame" style="height:{{previewHeight}}px">
        <view class="preview-placeholder" wx:if="{{hasMosaic && !previewLayers.length}}">等待马赛克预览</view>
        <image wx:for="{{previewLayers}}" wx:key="path" class="page-image {{item.visible ? 'page-image-visible' : ''}}"
          src="{{item.path}}" data-path="{{item.path}}" style="{{item.style}}" mode="aspectFit" bindload="finishPreviewLoad" binderror="failPreviewLoad" />
        <button class="image-arrow image-arrow-prev" data-direction="-1" bindtap="changePage"
          disabled="{{!!busy || swapFrom >= 0 || selected === 0}}" aria-label="上一页">‹</button>
        <button class="image-arrow image-arrow-next" data-direction="1" bindtap="changePage"
          disabled="{{!!busy || swapFrom >= 0 || selected === pageCount - 1}}" aria-label="下一页">›</button>
      </view>
    </view>

    <scroll-view class="controls-scroll" scroll-y="{{dragId < 0}}" enhanced show-scrollbar="{{false}}">
      <view class="controls-content">
        <view class="button-row organizer-actions">
          <button class="secondary organizer-button" data-direction="-1" bindtap="moveSelectedPage" disabled="{{!!busy || selected === 0 || dragId >= 0}}"><text class="organizer-symbol" aria-hidden="true">←</text><text>左移</text></button>
          <button class="secondary organizer-button" data-direction="1" bindtap="moveSelectedPage" disabled="{{!!busy || selected === pageCount - 1 || dragId >= 0}}"><text class="organizer-symbol" aria-hidden="true">→</text><text>右移</text></button>
          <button class="secondary organizer-button" bindtap="openCrop" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}"><text class="organizer-symbol" aria-hidden="true">✂</text><text>裁切</text></button>
          <button class="secondary organizer-button" bindtap="rotate" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}" aria-label="顺时针旋转"><text class="organizer-symbol" aria-hidden="true">↻</text></button>
          <button class="secondary organizer-button" bindtap="restoreCrop" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}" aria-label="还原完整裁切范围"><text>还原</text></button>
        </view>
        <view class="panel organizer">
          <view class="panel-top">
            <view class="heading">整理页面</view>
            <button class="organizer-add" bindtap="showImportOptions" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}" aria-label="新增图片"><text aria-hidden="true">＋</text></button>
          </view>
          <view class="thumbnail-row">
            <scroll-view class="thumbnail-strip" scroll-x="{{dragId < 0}}" enhanced show-scrollbar="{{false}}" scroll-left="{{thumbScrollLeft}}"
              scroll-into-view="{{thumbAnchor}}" bindscroll="onThumbnailsScroll" aria-label="扫描页列表">
              <view class="thumbnail-track" style="transform:translateX({{thumbTrackShift}}px)">
                <view wx:for="{{pages}}" wx:key="id" id="scan-page-{{item.id}}" data-index="{{index}}"
                  class="thumbnail {{selected === index ? 'thumbnail-selected' : ''}} {{dragId >= 0 || swapFrom >= 0 ? 'thumbnail-moving' : ''}} {{dragId === item.id ? 'thumbnail-dragging' : ''}} {{swapFrom === index || swapTo === index ? 'thumbnail-swapping' : ''}}"
                  style="transform:translateX({{((dragFrom < index && index <= dragTarget) || (dragTarget <= index && index < dragFrom)) ? dragNeighborShift : (swapFrom === index ? swapShift : (swapTo === index ? -swapShift : 0))}}px)"
                  bindtap="selectPage" bindtouchstart="rememberPageTouch"
                  bindtouchmove="movePageDrag" bindtouchend="endPageDrag" bindtouchcancel="cancelPageDrag">
                  <view class="thumbnail-tap" aria-role="button" aria-label="第 {{index + 1}} 页">
                    <view class="thumbnail-photo" style="width:{{item.width}}px;height:{{item.height}}px">
                      <image wx:if="{{item.source}}" src="{{item.source}}" mode="scaleToFill" style="{{item.photoStyle}}" lazy-load />
                      <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="id" class="thumbnail-edge" style="{{line.style}}" />
                    </view>
                  </view>
                  <button wx:if="{{selected === index}}" class="page-delete {{deleteArmed === item.id ? 'page-delete-armed' : ''}}"
                    data-id="{{item.id}}" data-delete-control="true" catchtap="removePage" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}"
                    aria-label="{{deleteArmed === item.id ? '确认删除当前页' : '删除当前页'}}"><text class="delete-label" data-delete-control="true">{{deleteArmed === item.id ? '删除' : '×'}}</text></button>
                  <view class="thumbnail-foot">
                    <text class="thumbnail-number">{{index + 1}}</text>
                  </view>
                </view>
              </view>
            </scroll-view>
            <slider wx:if="{{thumbMaxOffset > 0}}" class="thumbnail-slider" min="0" max="1000" step="1" value="{{thumbProgress}}"
              block-size="14" block-color="#317365" backgroundColor="#e1ebe4" activeColor="#a7c8b9"
              disabled="{{dragId >= 0 || !!busy}}" aria-label="横向滚动缩略图" bindtouchstart="beginThumbScrub"
              bindchanging="scrubThumbnails" bindchange="finishThumbScrub" bindtouchend="endThumbTouch" bindtouchcancel="cancelThumbScrub" />
          </view>
          <button wx:if="{{needsAlbumAccess}}" class="secondary full-width" open-type="openSetting"
            bindopensetting="refreshAlbumPermission" disabled="{{!!busy}}">开启相册保存权限</button>
        </view>

        <view class="panel" wx:if="{{candidate}}">
          <view class="heading">服务器处理结果</view>
          <view class="candidate-frame"><image src="{{candidate}}" mode="aspectFit" /></view>
          <view class="button-row">
            <button class="secondary" bindtap="dismissCandidate">舍弃</button>
            <button class="primary" bindtap="useCandidate">采用此结果</button>
          </view>
        </view>

        <view class="panel">
          <view class="heading">页面工具</view>
          <view class="button-row options">
            <button class="secondary" bindtap="openDecorations" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}">马赛克与水印</button>
            <button class="secondary" bindtap="openSmartTools" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}">智能工具</button>
          </view>
          <button class="secondary full-width" bindtap="openArchive" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}">错题归档</button>
        </view>

        <view class="panel">
          <view class="heading">文字识别</view>
          <view class="support ocr-description" wx:if="{{cloudEnabled}}">{{hasEnhanced ? '使用已采用的服务器增强图。' : '按当前裁切与方向准备识别图片。'}}</view>
          <view class="support ocr-description" wx:else>尚未配置 VPS 文字识别服务。</view>
          <button class="secondary full-width" bindtap="startOcr" disabled="{{!cloudEnabled || !!busy || dragId >= 0 || swapFrom >= 0}}">识别第 {{selected + 1}} 页</button>
          <view class="support ocr-description" wx:if="{{ocrMessage}}" aria-role="status">{{ocrMessage}}</view>
          <view class="ocr-result" wx:if="{{ocrText}}">
            <text class="ocr-text" user-select="{{true}}">{{ocrText}}</text>
            <button class="primary full-width" bindtap="copyOcr">复制文字</button>
          </view>
        </view>

        <view class="panel">
          <view class="heading">文档增强</view>
          <view wx:if="{{hasEnhanced}}" class="support active-cloud">已采用服务器增强。更改设置会重新处理原图。</view>
          <view class="button-row options" aria-label="图像色彩">
            <button wx:for="{{modes}}" wx:key="value" class="option {{mode === item.value ? 'option-active' : ''}}"
              data-mode="{{item.value}}" bindtap="selectMode" disabled="{{!!busy}}">{{item.label}}</button>
          </view>
          <view class="setting"><text>均衡光照</text><switch checked="{{enhance}}" disabled="{{!!busy}}" bindchange="toggleEnhance" color="#185e53" /></view>
          <view class="setting"><text>轻度去噪</text><switch checked="{{denoise}}" disabled="{{!!busy}}" bindchange="toggleDenoise" color="#185e53" /></view>
          <view class="setting">锐化</view>
          <view class="button-row sharpen-options" aria-label="锐化强度">
            <button wx:for="{{sharpening}}" wx:key="value" class="option {{sharpen === item.value ? 'option-active' : ''}}"
              data-level="{{item.value}}" bindtap="selectSharpen" disabled="{{!!busy || dragId >= 0 || swapFrom >= 0}}">{{item.label}}</button>
          </view>
          <view class="setting"><text>书页展平</text><switch checked="{{dewarp}}" disabled="{{!!busy}}" bindchange="toggleDewarp" color="#185e53" /></view>
          <view wx:if="{{dewarp}}" class="support">适合文字行清晰的弯曲书页。</view>
          <button wx:if="{{pageCount > 1}}" class="secondary full-width" bindtap="applyEnhancementToAll" disabled="{{!!busy}}">将增强设置应用到全部页</button>
          <view wx:if="{{cloudEnabled}}" class="cloud-options">
            <view class="support">服务器增强仅处理当前页。</view>
            <view class="button-row">
              <button class="secondary" data-operation="dewarp" bindtap="startCloud" disabled="{{!!busy}}">服务器展平</button>
              <button class="secondary" data-operation="deshadow" bindtap="startCloud" disabled="{{!!busy}}">深阴影处理</button>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{dragGhost}}" class="thumbnail thumbnail-ghost {{dragSettling ? 'thumbnail-ghost-settling' : ''}}"
    style="transform:translate3d({{dragGhost.left}}px,{{dragGhost.top}}px,0)" aria-hidden="true">
    <view class="thumbnail-tap">
      <view class="thumbnail-photo" style="width:{{dragGhost.width}}px;height:{{dragGhost.height}}px">
        <image wx:if="{{dragGhost.source}}" src="{{dragGhost.source}}" mode="scaleToFill" style="{{dragGhost.photoStyle}}" />
        <view wx:for="{{dragGhost.lines}}" wx:key="id" class="thumbnail-edge" style="{{item.style}}" />
      </view>
    </view>
    <view class="thumbnail-foot"><text class="thumbnail-number">{{dragGhost.number}}</text></view>
  </view>

  <view wx:if="{{busy}}" class="status" aria-role="status">
    <view class="status-message"><view class="status-dot" />{{busy}}</view>
    <button wx:if="{{ocrRunning}}" class="status-cancel" bindtap="cancelOcr">取消</button>
    <button wx:elif="{{cloudRunning}}" class="status-cancel" bindtap="cancelCloud">取消</button>
  </view>
</view>
