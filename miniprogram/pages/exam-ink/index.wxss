page { background: #f2f5f1; color: #172d25; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.editor { padding: 20rpx 22rpx 42rpx; padding-bottom: calc(42rpx + env(safe-area-inset-bottom)); }
.panel { background: #fff; border: 1rpx solid #dfe7e1; border-radius: 23rpx; margin-bottom: 18rpx; padding: 20rpx; }
.inspector { padding: 15rpx; }
.toolbar, .controls, .tools, .area, .progress, .brush-row { align-items: center; display: flex; gap: 10rpx; }
.toolbar, .progress { justify-content: space-between; }
.heading { font-size: 32rpx; font-weight: 650; }
.ink-frame { background: #152b25; border-radius: 15rpx; margin: 14rpx auto; overflow: hidden; position: relative; touch-action: none; }
.ink-stage { position: absolute; }
.page-image, .stroke-layer { height: 100%; left: 0; pointer-events: none; position: absolute; top: 0; width: 100%; }
.region { background: #ffb13430; border: 2px dashed #b97714; box-sizing: border-box; position: absolute; z-index: 3; }
.region.accepted { background: #35a49e23; border-color: #206e60; border-style: solid; }
.region.selected-region, .region.draft { border-color: #113b32; box-shadow: 0 0 0 1px #fff; }
.region.draft { pointer-events: none; }
.region-handle { align-items: center; background: #fff; border: 2px solid #185e53; border-radius: 50%; bottom: -8px; height: 14px; position: absolute; right: -8px; width: 14px; }
.stroke-layer { overflow: hidden; z-index: 4; }
.stroke { border-radius: 999px; pointer-events: none; position: absolute; transform-origin: 0 50%; }
.stroke.erase { background: #e25a4a88; }
.stroke.protect { background: #29b4a188; }

button { background: #eaf2ec; border: none; border-radius: 12rpx; box-sizing: border-box; color: #194639; font-size: 27rpx; font-weight: 600; line-height: 1.25; margin: 0; min-height: 68rpx; padding: 16rpx 10rpx; }
button::after { border: none; }
button[disabled] { opacity: 0.5; }
button.primary { background: #185e53; color: #fff; }
button.active { background: #d9eee3; box-shadow: inset 0 0 0 2rpx #28806d; color: #164739; }
.compact { font-size: 24rpx; min-height: 48rpx; padding: 8rpx 13rpx; white-space: nowrap; }
.bar button, .actions button { flex: 1; }
.bar, .actions { margin-top: 12rpx; }
.zoom-bar { margin-top: 12rpx; }
.zoom-level { font-size: 25rpx; min-width: 52rpx; text-align: center; }
.undo { margin-left: auto; }
.help, .notice { color: #53675d; font-size: 25rpx; line-height: 1.5; margin-top: 12rpx; }
.notice { background: #f8efdb; border-radius: 10rpx; color: #6a4a21; margin: 0 0 12rpx; padding: 12rpx; }
.brush-row { font-size: 25rpx; white-space: nowrap; }
.brush-slider { flex: 1; margin: 8rpx 4rpx; }
.regions { margin-top: 14rpx; max-height: 280rpx; overflow-y: auto; }
.area { margin-top: 9rpx; }
button.area-label { display: flex; flex: 1; font-size: 24rpx; gap: 8rpx; justify-content: space-between; min-height: 54rpx; padding: 10rpx 12rpx; }
.area-status { font-size: 22rpx; font-weight: 500; }
.progress { background: #e7f1ea; border-radius: 12rpx; font-size: 25rpx; margin-bottom: 12rpx; min-height: 48rpx; padding: 10rpx 14rpx; }
.full { width: 100%; }
