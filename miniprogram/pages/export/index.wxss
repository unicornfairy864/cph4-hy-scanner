page { background: #f2f5f1; color: #142923; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.export-page { padding: 28rpx; }
.export-card { background: #fff; border: 1rpx solid #dfe7e1; border-radius: 28rpx; padding: 32rpx; }
.existing-pdf { margin-bottom: 20rpx; }
.pdf-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.preview-frame { background: #152b25; border-radius: 18rpx; height: 44vh; max-height: 860rpx; overflow: hidden; position: relative; }
.preview-sheet { position: absolute; background: #fff; overflow: hidden; }
.preview-image { display: block; height: 100%; left: 50%; position: absolute; top: 50%; transform: translate(-50%,-50%); width: 100%; }
button.preview-arrow { align-items: center; background: #152b25cc; border: 1rpx solid #f2fff34d; border-radius: 50%; color: #fff; display: flex; font-size: 48rpx; height: 72rpx; justify-content: center; min-height: 72rpx; padding: 0 0 4rpx; position: absolute; top: 50%; transform: translateY(-50%); width: 72rpx; z-index: 2; }
.preview-prev { left: 10rpx; }
.preview-next { right: 10rpx; }
.preview-count { background: #152b25cc; border-radius: 18rpx; bottom: 12rpx; color: #fff; font-size: 24rpx; padding: 5rpx 12rpx; pointer-events: none; position: absolute; right: 12rpx; z-index: 2; }
.preview-placeholder { align-items: center; color: #edfff8; display: flex; flex-direction: column; font-size: 27rpx; gap: 12rpx; height: 100%; justify-content: center; }
button.preview-retry { min-height: 58rpx; padding: 12rpx 24rpx; }
.signature-overlay { outline: 1rpx dashed #77998c; outline-offset: 4rpx; position: absolute; touch-action: none; z-index: 1; }
.signature-overlay::before { bottom: -12rpx; content: ''; left: -12rpx; position: absolute; right: -12rpx; top: -12rpx; }
.signature-segment { background: #14211f; border-radius: 50px; pointer-events: none; position: absolute; transform-origin: top left; }
.signature-hint { color: #586963; font-size: 25rpx; margin-top: 12rpx; }
button.signature-all { margin-top: 12rpx; width: 100%; }
button.signing-switch { margin-top: 24rpx; width: 100%; }
.export-field { margin-top: 30rpx; }
.field-label { color: #29463e; font-size: 28rpx; font-weight: 600; }
.export-field input { background: #f2f6f3; border-radius: 16rpx; font-size: 28rpx; height: 80rpx; margin-top: 12rpx; padding: 0 20rpx; }
.choice-row { display: flex; gap: 12rpx; margin-top: 12rpx; }
button { border: none; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; line-height: 1.3; min-height: 78rpx; padding: 20rpx 12rpx; }
button::after { border: none; }
button.choice { background: #eff4ef; color: #204137; flex: 1; margin: 0; }
button.choice-active { background: #deefe7; box-shadow: inset 0 0 0 2rpx #257569; color: #104b40; }
button.primary { background: #185e53; color: #fff; margin: 34rpx 0 0; }
button[disabled] { opacity: 0.65; }
.export-note { color: #586963; font-size: 26rpx; line-height: 1.45; margin-top: 18rpx; }
.ink-mask { align-items: center; background: #102a22a8; bottom: 0; display: flex; justify-content: center; left: 0; padding: 28rpx; position: fixed; right: 0; top: 0; z-index: 12; }
.ink-dialog { background: #fff; border-radius: 28rpx; box-sizing: border-box; padding: 28rpx; width: 100%; }
.ink-surface { background: #fff; border: 2rpx dashed #a4b9ad; border-radius: 16rpx; height: 240rpx; margin: 20rpx 0; overflow: hidden; touch-action: none; }
.ink-pad { display: block; height: 100%; pointer-events: none; width: 100%; }
.ink-dialog .choice-row > button { flex: 1; margin: 0; }
