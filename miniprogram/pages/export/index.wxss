page { background: #f2f5f1; color: #142923; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.export-page { padding: 28rpx; }
.export-card { background: #fff; border: 1rpx solid #dfe7e1; border-radius: 28rpx; padding: 32rpx; }
.export-title { font-size: 40rpx; font-weight: 700; }
.export-field { margin-top: 30rpx; }
.field-label { color: #29463e; font-size: 28rpx; font-weight: 600; }
.export-field input { background: #f2f6f3; border-radius: 16rpx; font-size: 28rpx; height: 80rpx; margin-top: 12rpx; padding: 0 20rpx; }
.choice-row { display: flex; gap: 12rpx; margin-top: 12rpx; }
button { border: none; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; line-height: 1.3; min-height: 78rpx; padding: 20rpx 12rpx; }
button::after { border: none; }
button.choice { background: #eff4ef; color: #204137; flex: 1; margin: 0; }
button.choice-active { background: #deefe7; box-shadow: inset 0 0 0 2rpx #257569; color: #104b40; }
button.primary { background: #185e53; color: #fff; margin: 34rpx 0 0; }
button[disabled] { opacity: 0.65; }
.export-note { color: #586963; font-size: 26rpx; line-height: 1.45; margin-top: 18rpx; }
